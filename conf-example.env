# Required ---------------------------------------

# Docker apps source folder
SOURCE=/home/starry/docker-apps

# Rclone destination remote:path
RCLONE_DEST=starrygd:backups

# Optional ---------------------------------------

# Local scratch directory used while building the archive
LOCAL_DEST=/tmp/.backup-staging

# Explicit rclone config file path, if needed (recommended: leave empty unless systemd needs it)
# RCLONE_CONFIG=

# rclone options (leave default, unless really needed)
RCLONE_STATS_INTERVAL=10s
RCLONE_DRIVE_CHUNK_SIZE=64M
RCLONE_BUFFER_SIZE=32M

# Remote backups to keep (recommended: 4)
MAX_KEEP=4

# zstd compression level (recommended: 9)
ZSTD_LEVEL=9

# Graceful stop timeout in seconds for stateful stacks (recommended: 60)
STOP_TIMEOUT=60

# Comma-separated project names that should not ever be restarted after backup
NO_AUTOSTART_PROJECTS=tdl-tg

# Telegram bot token and chat-id for alerts
BOT_TOKEN=
CHAT_ID=

# Optional HTTPS proxy for Telegram API requests
# TELEGRAM_PROXY=https://user:pass@proxy.example.com:8443

# Optional Telegram Bot API base URL
# TELEGRAM_API_BASE_URL=https://api.telegram.org